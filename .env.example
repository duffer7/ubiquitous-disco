# ============================================================================
# Environment configuration — copy to `.env.local` for local development.
#
#   cp .env.example .env.local
#
# NEVER commit real secrets. In production, set these through your platform's
# secret manager (Vercel env vars, AWS SSM/Secrets Manager, Docker secrets…).
# ============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. For the Dockerised database this points at the
# `db` service; for local host development use `localhost`.
DATABASE_URL=postgresql://app:app_password@localhost:5432/saas_dashboard

# --- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs (HS256). MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=dev-secret-please-change-in-prod-at-least-32-chars-long

# --- Public -----------------------------------------------------------------
# Base URL of the deployed app. Used for password-reset links and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
